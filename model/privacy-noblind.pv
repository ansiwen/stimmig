(* CONTROL: privacy without blinding. The registrar signs the credential
   message itself, so it sees which credential belongs to which voter. The
   attacker must be able to link ballots to identities: the check must FAIL.
   If it proved privacy, the model would prove nothing. Compare privacy.pv. *)

free c: channel.                 (* the network; also the way to the ballot box *)
free creg: channel.              (* the registration: public, the registrar is the attacker *)
free cmixA: channel [private].   (* the cast of voter A, to be released in no order *)
free cmixB: channel [private].   (* the cast of voter B *)
free cboxA: channel [private].   (* the honest ballots, to the ballot box *)
free cboxB: channel [private].
free cstoreA: channel [private]. (* what the ballot box accepted, to the tally *)
free cstoreB: channel [private].
free cstoreC: channel [private]. (* the ballot of the attacker *)
free eid: bitstring.
free va, vb: bitstring.
free idA, idB: ident.

let Voter(cmix: channel, id: ident, v: bitstring, pkR: pkey, pkE: pkey) =
  new cred: skey;
  new r: rand;
  new r2: rand;
  let pubc = pk(cred) in
  let m = h((tagCred, eid, pubc)) in
  out(creg, (id, m));
  in(creg, sg: bitstring);
  if rsacheck(sg, pkR) = m then
  phase 1;
  let ct = hpke(v, pkE, (tagInfo, eid, pubc), r2) in
  let sb = edsign((tagBallot, eid, ct), cred) in
  out(cmix, (pubc, sg, ct, sb)).

(* The two honest ballots reach the network as an unordered pair: in the
   right-hand process they come in the other order, so that the position of a
   ballot says nothing about its voter. Each voter has a channel of its own, so
   that the order is fixed (ProVerif would otherwise merge the two possible
   orders and report an attack that cannot happen). *)
let Mixer() =
  phase 1;
  in(cmixA, b1: bitstring);
  in(cmixB, b2: bitstring);
  out(c, choice[(b1, b2), (b2, b1)]);
  out(cboxA, b1);
  out(cboxB, b2).

(* The ballot box accepts a ballot with a valid credential and a valid
   signature. It does not refuse a second ballot of a credential here: that
   is a matter of integrity (integrity.pv), and accepting replays only gives
   the attacker more to work with. *)
let BoxIn(chIn: channel, chOut: channel, pkR: pkey) =
  phase 1;
  in(chIn, (pubc: pkey, sg: bitstring, ct: bitstring, sb: bitstring));
  if rsacheck(sg, pkR) = h((tagCred, eid, pubc)) then
  if edcheck(sb, pubc) = (tagBallot, eid, ct) then
  out(chOut, (pubc, sg, ct, sb)).

(* At the close, the key is published and every ballot is published with its
   decryption. The two honest entries are released as an unordered pair. *)
let Tally(skE: skey) =
  phase 1;
  in(cstoreA, (p1: pkey, g1: bitstring, c1: bitstring, s1: bitstring));
  in(cstoreB, (p2: pkey, g2: bitstring, c2: bitstring, s2: bitstring));
  in(cstoreC, (p3: pkey, g3: bitstring, c3: bitstring, s3: bitstring));
  phase 2;
  out(c, skE);
  let e1 = (p1, g1, c1, s1, hdec(c1, skE, (tagInfo, eid, p1))) in
  let e2 = (p2, g2, c2, s2, hdec(c2, skE, (tagInfo, eid, p2))) in
  let e3 = (p3, g3, c3, s3, hdec(c3, skE, (tagInfo, eid, p3))) in
  out(c, choice[(e1, e2, e3), (e2, e1, e3)]).

process
  new skR: skey;
  new skE: skey;
  let pkR = pk(skR) in
  let pkE = pk(skE) in
  out(c, pkR);
  out(c, pkE);
  out(c, skR);
  ( Voter(cmixA, idA, choice[va, vb], pkR, pkE)
  | Voter(cmixB, idB, choice[vb, va], pkR, pkE)
  | Mixer()
  | BoxIn(cboxA, cstoreA, pkR)
  | BoxIn(cboxB, cstoreB, pkR)
  | BoxIn(c, cstoreC, pkR)
  | Tally(skE) )
